# Fichiers systeme macOS
.DS_Store
**/.DS_Store

# Caches Python du generateur du backoffice
__pycache__/
*.pyc

# Archives et exports
*.zip

# Sauvegardes locales
*.bak
*.bak.*
frontoffice/_git-ancien

# Gabarit commercial NexLink (LayoutDrop), conserve en local comme reference.
# Non versionne : sa licence n'autorise pas la redistribution, et son seul
# fichier utile (styles.css) est deja copie dans backoffice/assets/css/.
demo/

# Application Laravel (backoffice) : dependances et artefacts locaux
app-laravel/vendor/
app-laravel/node_modules/
app-laravel/.env
app-laravel/public/build/
app-laravel/storage/*.key

# Worktrees git locaux. Un worktree contient un fichier .git, que git
# enregistre alors comme gitlink (mode 160000) : le dossier apparait
# eternellement « modifie » puisque le worktree avance et que le SHA grave
# dans la branche ne bouge pas. Ce sont des checkouts locaux, pas du contenu.
.claude/worktrees/
