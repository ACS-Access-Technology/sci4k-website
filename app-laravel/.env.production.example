# Les variables de PRODUCTION.
#
# Le site se deploie en conteneur sur Railway (docs/PREMIER_DEPLOIEMENT.md) :
# ces variables se posent dans l'ecran « Variables » du service, PAS dans un
# fichier .env — l'image n'en emporte aucun. Ce gabarit en est la liste de
# reference. Le fichier .env ne sert que sur un hebergement classique, plan de
# repli decrit dans docs/MISE_EN_LIGNE.md.
#
# .env.example, a cote, est le gabarit de DEVELOPPEMENT : il porte
# APP_ENV=local et APP_DEBUG=true, ce qui convient sur un poste et nulle part
# ailleurs. Deployer en copiant .env.example afficherait la page d'erreur
# complete de Laravel au premier visiteur venu — trace d'execution, requetes
# SQL, et le contenu des variables d'environnement.
#
# Hebergement classique seulement : copier CE fichier, puis renseigner ce
# qui est marque « A RENSEIGNER ».
#
#   cp .env.production.example .env
#   php artisan key:generate
#
# Les valeurs deja remplies sont celles qui doivent rester telles quelles.

APP_NAME=SCI4K
APP_ENV=production

# Toujours false. Le conteneur REFUSE de demarrer avec toute autre valeur
# (tools/demarrer-conteneur.sh), quel que soit APP_ENV.
APP_DEBUG=false

# Generee sur un poste par « php artisan key:generate --show », puis recopiee.
# Ne jamais reutiliser la cle d'un autre environnement : elle dechiffre les
# cookies et les sessions. Le conteneur refuse de demarrer si elle est vide.
#
# NE PAS LA CHANGER sans avoir pose PASSKEYS_USER_HANDLE_SECRET ci-dessous :
# tant qu'il est vide, la cle d'application en tient lieu, et la changer rend
# inutilisables toutes les passkeys deja enregistrees.
APP_KEY=

# Le secret dont est derive l'identifiant de chaque passkey (HMAC du compte).
# Vide : APP_KEY. LE CHANGER INVALIDE TOUTES LES PASSKEYS EXISTANTES — leurs
# titulaires devront se reconnecter par mot de passe et les recreer.
#
# Pour detacher les passkeys de APP_KEY sans rien casser : poser ici la valeur
# ACTUELLE de APP_KEY, a l'identique. Rien ne change pour les passkeys, et
# APP_KEY peut ensuite tourner seule. Sur une installation neuve : une valeur
# aleatoire distincte (php -r "echo base64_encode(random_bytes(32));").
#
# Les passkeys dependent aussi du DOMAINE : l'identifiant de « partie de
# confiance » est l'hote de APP_URL. Au passage au domaine definitif, celles
# creees sur l'adresse d'essai cessent de fonctionner, quoi qu'on fasse ici.
PASSKEYS_USER_HANDLE_SECRET=

# L'adresse publique, avec le protocole. Elle sert a fabriquer les liens des
# courriels et le plan du site, qui n'ont pas de requete HTTP pour la deduire.
# A RENSEIGNER
APP_URL=https://exemple.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# En conteneur : la sortie d'erreur, que Railway collecte et affiche dans les
# journaux du service. Un fichier ecrit dans le conteneur disparaitrait au
# redeploiement suivant, avec ce qu'il disait de la panne.
#
# Hebergement classique seulement : LOG_STACK=daily (un fichier par jour, garde
# LOG_DAILY_DAYS jours). Jamais « single », le defaut de developpement : un
# fichier unique que rien ne fait tourner, jusqu'a saturer le disque.
#
# « warning » : les erreurs et les anomalies, sans le bruit de chaque requete.
# « debug » consignerait en plus chaque requete SQL — avec ses valeurs.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# A RENSEIGNER. Sur Railway, par reference au service MySQL :
# DB_HOST=${{MySQL.MYSQLHOST}}, etc. (docs/DEPLOIEMENT_RAILWAY.md, § 3).
# Ailleurs, un compte dedie a l'application, avec les droits sur cette seule
# base — pas root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Le cookie de session n'est alors plus emis que sur HTTPS. Sans cette ligne,
# il part aussi en clair, et se laisse lire sur le trajet. A laisser a true
# des lors que le site est servi en HTTPS — ce qui doit etre le cas.
SESSION_SECURE_COOKIE=true

# A RENSEIGNER SI, ET SEULEMENT SI, un proxy se tient devant PHP : nginx en
# frontal, un repartiteur de charge, Cloudflare. Sans cela, isSecure() repond
# faux derriere le proxy : les liens et les redirections repartent en http,
# le cookie ci-dessus n'est jamais marque Secure malgre la ligne precedente,
# et la limitation de debit compte toutes les visites sur l'adresse du proxy,
# c'est-a-dire sur un seul compteur pour le monde entier.
#
# Adresses ou plages separees par des virgules. « * » n'est acceptable que si
# PHP n'est joignable QUE par le proxy ; sinon chacun se declare ce qu'il veut.
# Laisser vide en l'absence de proxy : la ligne est alors sans effet.
#
# Railway : « * ». Il termine le TLS devant le conteneur, qui n'est joignable
# que par son proxy.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# A RENSEIGNER. MAIL_MAILER=log N'EST PAS UNE CONFIGURATION DE PRODUCTION :
# il ecrit les courriels dans le journal et n'envoie rien — ni l'accuse d'un
# message de contact, ni l'alerte d'une demande de visite, ni l'avis d'un
# nouveau commentaire, ni l'invitation d'un compte du backoffice, ni la
# reinitialisation d'un mot de passe.
#
# Le serveur SMTP peut aussi se saisir dans l'ecran Configuration du
# backoffice, qui prime alors sur ces variables et comporte un bouton d'essai.
# Mais il ne s'applique qu'aux pages : une commande lancee en console garde
# ces variables-ci. D'ou l'interet de les poser quand meme.
#
# MAIL_FROM_ADDRESS : une adresse du domaine de l'agence, autorisee par le
# fournisseur SMTP (SPF, DKIM). Vide, Laravel retombe sur hello@example.com :
# des courriels refuses ou classes en indesirables, au nom d'un domaine qui
# n'est pas le sien.
#
# Les identifiants ne se recopient jamais dans un fichier du depot : ils se
# posent dans les variables du service.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Traduction automatique des articles (DeepL). Facultatif : sans cle, la
# fonction se tait et les deux langues se saisissent a la main.
DEEPL_API_KEY=

# A RENSEIGNER si un projet Sentry existe. Sans DSN, rien n'est envoye et le
# site fonctionne normalement — mais personne n'est prevenu des erreurs.
#
# Aucune donnee personnelle ne part : ni adresse IP, ni navigateur, ni corps
# ou chaine de requete, ni valeur saisie. send_default_pii=false n'y suffisait
# pas : voir app/Support/SentryAvantEnvoi.php. La politique de confidentialite
# promet en gras qu'aucune IP n'est conservee ; l'envoyer a un tiers
# reviendrait au meme mensonge par un autre chemin. Seul l'identifiant interne
# du compte backoffice connecte accompagne le rapport.
SENTRY_LARAVEL_DSN=

# Le nom sous lequel Sentry range les erreurs. Vide : APP_ENV. A poser des que
# deux instances existent — « essai » pour l'actuelle, « production » pour le
# site definitif —, sans quoi leurs erreurs se melangent.
SENTRY_ENVIRONMENT=

# La version deployee. Vide : le commit si la plateforme le fournit, a defaut
# l'identifiant du deploiement. « railway up » ne transmet pas de commit :
# Sentry range alors les erreurs par deploiement Railway, ce qui suffit a dire
# depuis quelle mise en ligne une erreur apparait. Ailleurs, a poser a chaque
# mise en ligne.
SENTRY_RELEASE=

# Part des requetes tracees pour la mesure de performance. Vide ou 0 : aucune.
# Les traces consomment le quota Sentry bien plus vite que les erreurs.
SENTRY_TRACES_SAMPLE_RATE=0
