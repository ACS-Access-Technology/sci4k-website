# Gabarit du fichier .env de PRODUCTION.
#
# .env.example, a cote, est le gabarit de DEVELOPPEMENT : il porte
# APP_ENV=local et APP_DEBUG=true, ce qui convient sur un poste et nulle part
# ailleurs. Deployer en copiant .env.example afficherait la page d'erreur
# complete de Laravel au premier visiteur venu — trace d'execution, requetes
# SQL, et le contenu des variables d'environnement.
#
# Copier CE fichier, puis renseigner ce qui est marque « A RENSEIGNER ».
#
#   cp .env.production.example .env
#   php artisan key:generate
#
# Les valeurs deja remplies sont celles qui doivent rester telles quelles.

APP_NAME=SCI4K
APP_ENV=production
APP_DEBUG=false

# Genere par « php artisan key:generate ». Ne jamais reutiliser la cle d'un
# autre environnement : elle dechiffre les cookies et les sessions.
APP_KEY=

# L'adresse publique, avec le protocole. Elle sert a fabriquer les liens des
# courriels et le plan du site, qui n'ont pas de requete HTTP pour la deduire.
# A RENSEIGNER
APP_URL=https://exemple.ci

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Un fichier par jour, garde deux semaines. « single » — le defaut du gabarit
# de developpement — ecrit dans un fichier unique que rien ne fait tourner :
# il grossit jusqu'a saturer le disque. Le niveau « debug » consignerait en
# plus chaque requete SQL.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# A RENSEIGNER. Un compte dedie a l'application, avec les droits sur cette
# seule base — pas root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Le cookie de session n'est alors plus emis que sur HTTPS. Sans cette ligne,
# il part aussi en clair, et se laisse lire sur le trajet. A laisser a true
# des lors que le site est servi en HTTPS — ce qui doit etre le cas.
SESSION_SECURE_COOKIE=true

# A RENSEIGNER SI, ET SEULEMENT SI, un proxy se tient devant PHP : nginx en
# frontal, un repartiteur de charge, Cloudflare. Sans cela, isSecure() repond
# faux derriere le proxy : les liens et les redirections repartent en http,
# le cookie ci-dessus n'est jamais marque Secure malgre la ligne precedente,
# et la limitation de debit compte toutes les visites sur l'adresse du proxy,
# c'est-a-dire sur un seul compteur pour le monde entier.
#
# Adresses ou plages separees par des virgules. « * » n'est acceptable que si
# PHP n'est joignable QUE par le proxy ; sinon chacun se declare ce qu'il veut.
# Laisser vide en l'absence de proxy : la ligne est alors sans effet.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# A RENSEIGNER. Sans SMTP reel, MAIL_MAILER=log ecrit les courriels dans le
# journal et n'envoie rien : ni l'accuse d'un message de contact, ni l'alerte
# d'une demande de visite, ni l'avis d'un nouveau commentaire, ni l'invitation
# d'un compte du backoffice. L'ecran Configuration comporte un bouton d'essai
# pour verifier ces identifiants une fois renseignes.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Traduction automatique des articles (DeepL). Facultatif : sans cle, la
# fonction se tait et les deux langues se saisissent a la main.
DEEPL_API_KEY=
